---
/**
 * The 404 keeps the template's vocabulary: the numeral is the largest thing on
 * the page, and there is nothing else to look at.
 */
---

<main class="hz-notfound">
  <b class="hz-num" aria-hidden="true">404</b>
  <h1>This page is not on the axis.</h1>
  <p>
    The page you asked for does not exist, or has moved. Everything that has been
    published is in the archive.
  </p>
  <p class="hz-links" style="margin-top: 28px">
    <a href="/">Home</a>
    <a href="/posts">Archive</a>
  </p>
</main>
