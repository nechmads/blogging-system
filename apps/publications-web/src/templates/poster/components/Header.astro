---
/**
 * Poster header: the rail. On desktop it is two pieces — the publication name
 * running vertically up the right edge of the first screen, and a small nav
 * cluster fixed bottom-right. Under 760px both collapse into one thin sticky
 * top strip. Both are in the DOM; CSS picks one.
 *
 * `showDate` marks the home page in the switchers. Poster's rail is identical
 * on every page (the masthead *is* the identity, so it never changes rank), so
 * the flag is accepted and deliberately unused.
 */
interface Props {
  publicationName: string;
  logoUrl: string | null;
  showDate?: boolean;
}

const { publicationName, logoUrl } = Astro.props;

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'home' },
  { href: '/posts', label: 'archive' },
  { href: '/rss', label: 'rss' },
] as const;

/** The rail is narrow, so a long name is set a step smaller rather than clipped. */
const mastheadStyle =
  publicationName.trim().length > 34 ? 'font-size: 0.9375rem;' : undefined;
---

<header>
  <p class:list={['po-masthead', logoUrl && 'po-masthead--logo']}>
    <a href="/" style={logoUrl ? undefined : mastheadStyle}>
      {logoUrl ? (
        <img src={logoUrl} alt={publicationName} loading="eager" />
      ) : (
        publicationName
      )}
    </a>
  </p>

  <nav class="po-rail-nav" aria-label="Site">
    {navLinks.map(({ href, label }) => (
      <a href={href} aria-current={currentPath === href ? 'page' : undefined}>{label}</a>
    ))}
  </nav>

  <div class="po-strip">
    <a class="po-strip-name" href="/">
      {logoUrl ? (
        <img src={logoUrl} alt={publicationName} loading="eager" />
      ) : (
        publicationName
      )}
    </a>
    <nav aria-label="Site">
      {navLinks.slice(1).map(({ href, label }) => (
        <a href={href} aria-current={currentPath === href ? 'page' : undefined}>{label}</a>
      ))}
    </nav>
  </div>
</header>
