---
/**
 * Template switcher for post pages.
 * When adding a new template: add imports for its components and a new branch in the conditional below.
 * Also update HomePage.astro and NotFoundPage.astro switchers.
 */
import type { Post } from '@hotmetal/content-core';
import type { PublicationBranding } from '../dl/publication';
import CommentSection from './comments/CommentSection';

// Starter template
import StarterBaseLayout from '../templates/starter/layouts/BaseLayout.astro';
import StarterHeader from '../templates/starter/components/Header.astro';
import StarterFooter from '../templates/starter/components/Footer.astro';
import StarterPostContent from '../templates/starter/components/PostContent.astro';

// Editorial template
import EditorialBaseLayout from '../templates/editorial/layouts/BaseLayout.astro';
import EditorialHeader from '../templates/editorial/components/Header.astro';
import EditorialFooter from '../templates/editorial/components/Footer.astro';
import EditorialPostContent from '../templates/editorial/components/PostContent.astro';

// Press Machine template
import PressBaseLayout from '../templates/press-machine/layouts/BaseLayout.astro';
import PressHeader from '../templates/press-machine/components/Header.astro';
import PressFooter from '../templates/press-machine/components/Footer.astro';
import PressPostContent from '../templates/press-machine/components/PostContent.astro';

// One Signal template
import SignalBaseLayout from '../templates/one-signal/layouts/BaseLayout.astro';
import SignalHeader from '../templates/one-signal/components/Header.astro';
import SignalFooter from '../templates/one-signal/components/Footer.astro';
import SignalPostContent from '../templates/one-signal/components/PostContent.astro';

// CoverStock template
import CoverStockBaseLayout from '../templates/cover-stock/layouts/BaseLayout.astro';
import CoverStockHeader from '../templates/cover-stock/components/Header.astro';
import CoverStockPostContent from '../templates/cover-stock/components/PostContent.astro';
import CoverStockFooter from '../templates/cover-stock/components/Footer.astro';

// Horizon template
import HorizonBaseLayout from '../templates/horizon/layouts/BaseLayout.astro';
import HorizonHeader from '../templates/horizon/components/Header.astro';
import HorizonPostContent from '../templates/horizon/components/PostContent.astro';
import HorizonFooter from '../templates/horizon/components/Footer.astro';

// Poster template
import PosterBaseLayout from '../templates/poster/layouts/BaseLayout.astro';
import PosterHeader from '../templates/poster/components/Header.astro';
import PosterPostContent from '../templates/poster/components/PostContent.astro';
import PosterFooter from '../templates/poster/components/Footer.astro';
// Bold template
import BoldBaseLayout from '../templates/bold/layouts/BaseLayout.astro';
import BoldHeader from '../templates/bold/components/Header.astro';
import BoldFooter from '../templates/bold/components/Footer.astro';
import BoldPostContent from '../templates/bold/components/PostContent.astro';

interface Props {
  templateId: string;
  branding: PublicationBranding;
  post: Post;
  sanitizedContent: string;
  date: string | null;
  allLabels: string[];
  postUrl: string;
  twitterShareUrl: string;
  linkedinShareUrl: string;
  title: string;
  description: string;
  ogImage?: string;
  canonicalUrl: string;
  ogType: string;
  jsonLd: Record<string, unknown>;
  rssUrl: string;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleAuthor?: string;
  articleTags?: string[];
  articleSection?: string;
  twitterSite?: string;
  commentsEnabled: boolean;
  publicationSlug: string;
  turnstileSiteKey: string;
}

const {
  templateId,
  branding,
  post,
  sanitizedContent,
  date,
  allLabels,
  postUrl,
  twitterShareUrl,
  linkedinShareUrl,
  title,
  description,
  ogImage,
  canonicalUrl,
  ogType,
  jsonLd,
  rssUrl,
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor,
  articleTags,
  articleSection,
  twitterSite,
  commentsEnabled,
  publicationSlug,
  turnstileSiteKey,
} = Astro.props;

const layoutProps = {
  title,
  publicationName: branding.name,
  description,
  ogImage,
  canonicalUrl,
  accentColor: branding.accentColor,
  ogType,
  jsonLd,
  rssUrl,
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor,
  articleTags,
  articleSection,
  twitterSite,
};

const contentProps = {
  post,
  sanitizedContent,
  date,
  allLabels,
  postUrl,
  twitterShareUrl,
  linkedinShareUrl,
};
---

{templateId === 'cover-stock' ? (
  <CoverStockBaseLayout {...layoutProps}>
    <CoverStockHeader publicationName={branding.name} logoUrl={branding.logoUrl} />
    <CoverStockPostContent {...contentProps} publicationName={branding.name}>
      {commentsEnabled && (
        <CommentSection
          slot="comments"
          client:load
          publicationSlug={publicationSlug}
          postSlug={post.slug}
          turnstileSiteKey={turnstileSiteKey}
          commentsEnabled={commentsEnabled}
        />
      )}
    </CoverStockPostContent>
    <CoverStockFooter
      publicationName={branding.name}
      publicationSlug={branding.slug}
      socialLinks={branding.socialLinks}
    />
  </CoverStockBaseLayout>
) : templateId === 'horizon' ? (
  <HorizonBaseLayout {...layoutProps}>
    <HorizonHeader publicationName={branding.name} logoUrl={branding.logoUrl} />
    <HorizonPostContent {...contentProps} publicationName={branding.name}>
      {commentsEnabled && (
        <CommentSection
          slot="comments"
          client:load
          publicationSlug={publicationSlug}
          postSlug={post.slug}
          turnstileSiteKey={turnstileSiteKey}
          commentsEnabled={commentsEnabled}
        />
      )}
    </HorizonPostContent>
    <HorizonFooter
      publicationName={branding.name}
      publicationSlug={branding.slug}
      socialLinks={branding.socialLinks}
    />
  </HorizonBaseLayout>
) : templateId === 'poster' ? (
  <PosterBaseLayout {...layoutProps}>
    <PosterHeader publicationName={branding.name} logoUrl={branding.logoUrl} />
    <PosterPostContent {...contentProps} publicationName={branding.name}>
      {commentsEnabled && (
        <CommentSection
          slot="comments"
          client:load
          publicationSlug={publicationSlug}
          postSlug={post.slug}
          turnstileSiteKey={turnstileSiteKey}
          commentsEnabled={commentsEnabled}
        />
      )}
    </PosterPostContent>
    <PosterFooter
      publicationName={branding.name}
      publicationSlug={branding.slug}
      socialLinks={branding.socialLinks}
    />
  </PosterBaseLayout>
) : templateId === 'press-machine' ? (
  <PressBaseLayout {...layoutProps}>
    <PressHeader publicationName={branding.name} logoUrl={branding.logoUrl} />
    <PressPostContent {...contentProps}>
      {commentsEnabled && (
        <CommentSection
          slot="comments"
          client:load
          publicationSlug={publicationSlug}
          postSlug={post.slug}
          turnstileSiteKey={turnstileSiteKey}
          commentsEnabled={commentsEnabled}
        />
      )}
    </PressPostContent>
    <PressFooter
      publicationName={branding.name}
      publicationSlug={branding.slug}
      socialLinks={branding.socialLinks}
    />
  </PressBaseLayout>
) : templateId === 'one-signal' ? (
  <SignalBaseLayout {...layoutProps}>
    <SignalHeader publicationName={branding.name} logoUrl={branding.logoUrl} />
    <SignalPostContent {...contentProps}>
      {commentsEnabled && (
        <CommentSection
          slot="comments"
          client:load
          publicationSlug={publicationSlug}
          postSlug={post.slug}
          turnstileSiteKey={turnstileSiteKey}
          commentsEnabled={commentsEnabled}
        />
      )}
    </SignalPostContent>
    <SignalFooter
      publicationName={branding.name}
      publicationSlug={branding.slug}
      socialLinks={branding.socialLinks}
    />
  </SignalBaseLayout>
) : templateId === 'editorial' ? (
  <EditorialBaseLayout {...layoutProps}>
    <EditorialHeader publicationName={branding.name} logoUrl={branding.logoUrl} />
    <EditorialPostContent {...contentProps}>
      {commentsEnabled && (
        <CommentSection
          slot="comments"
          client:load
          publicationSlug={publicationSlug}
          postSlug={post.slug}
          turnstileSiteKey={turnstileSiteKey}
          commentsEnabled={commentsEnabled}
        />
      )}
    </EditorialPostContent>
    <EditorialFooter
      publicationName={branding.name}
      publicationSlug={branding.slug}
      socialLinks={branding.socialLinks}
    />
  </EditorialBaseLayout>
) : templateId === 'bold' ? (
  <BoldBaseLayout {...layoutProps}>
    <BoldHeader publicationName={branding.name} logoUrl={branding.logoUrl} />
    <BoldPostContent {...contentProps}>
      {commentsEnabled && (
        <CommentSection
          slot="comments"
          client:load
          publicationSlug={publicationSlug}
          postSlug={post.slug}
          turnstileSiteKey={turnstileSiteKey}
          commentsEnabled={commentsEnabled}
        />
      )}
    </BoldPostContent>
    <BoldFooter
      publicationName={branding.name}
      publicationSlug={branding.slug}
      socialLinks={branding.socialLinks}
    />
  </BoldBaseLayout>
) : (
  <StarterBaseLayout {...layoutProps}>
    <StarterHeader publicationName={branding.name} logoUrl={branding.logoUrl} />
    <StarterPostContent {...contentProps}>
      {commentsEnabled && (
        <CommentSection
          slot="comments"
          client:load
          publicationSlug={publicationSlug}
          postSlug={post.slug}
          turnstileSiteKey={turnstileSiteKey}
          commentsEnabled={commentsEnabled}
        />
      )}
    </StarterPostContent>
    <StarterFooter
      publicationName={branding.name}
      publicationSlug={branding.slug}
      socialLinks={branding.socialLinks}
    />
  </StarterBaseLayout>
)}
