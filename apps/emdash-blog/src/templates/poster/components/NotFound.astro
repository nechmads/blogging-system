---
/**
 * 404. The claim is that there is nothing here, so it is set like any other
 * claim: poster scale, left edge, one small line under it and one link out.
 */
---

<main class="po-hero po-notfound" id="main" aria-labelledby="po-nf">
  <p class="po-meta">error 404</p>

  <h1 class="po-poster po-nf-title" id="po-nf">Nothing at this address.</h1>

  <div class="po-hero-deck po-deck">
    <p>The page you are looking for does not exist, or it has moved.</p>
    <a class="po-more" href="/">&larr; Back to the front</a>
  </div>
</main>
