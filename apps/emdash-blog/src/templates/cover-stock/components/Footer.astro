---
import type { SocialLinks } from '@hotmetal/data-layer';

interface Props {
  publicationName: string;
  publicationSlug: string;
  socialLinks: SocialLinks | null;
}

const { publicationName, socialLinks } = Astro.props;

const year = new Date().getFullYear();

const links = [
  socialLinks?.twitter ? { href: socialLinks.twitter, label: 'X', external: true } : null,
  socialLinks?.linkedin ? { href: socialLinks.linkedin, label: 'LinkedIn', external: true } : null,
  socialLinks?.github ? { href: socialLinks.github, label: 'GitHub', external: true } : null,
  socialLinks?.website ? { href: socialLinks.website, label: 'Website', external: true } : null,
  { href: '/posts', label: 'Catalogue', external: false },
  { href: '/rss', label: 'RSS', external: false },
].filter((link): link is { href: string; label: string; external: boolean } => link !== null);
---

{/* The footer band is the shelf colour: the page ends on the same surface the
    covers stand on. */}
<footer class="cs-foot">
  <div class="cs-foot-in">
    <p><span class="cs-foot-name">{publicationName}</span></p>

    <p class="cs-foot-links">
      {links.map(({ href, label, external }) => (
        <a
          href={href}
          target={external ? '_blank' : undefined}
          rel={external ? 'noopener noreferrer' : undefined}
        >
          {label}
        </a>
      ))}
    </p>

    <p class="cs-foot-fine">
      &copy; {year} {publicationName} &middot; Made with{' '}
      <a href="https://hotmetalapp.com" target="_blank" rel="noopener noreferrer">
        Hot&nbsp;Metal
      </a>
    </p>
  </div>
</footer>
