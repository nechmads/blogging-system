---
/** Cover Stock 404 body, rendered between the header and the footer. */
---

<main class="cs-notfound flex-1 flex items-center px-6 py-24">
  <div class="mx-auto w-full max-w-[44rem]">
    <p class="text-sm uppercase tracking-wide mb-3">Error 404</p>
    <h1 class="font-[var(--font-display)] text-5xl mb-4">Nothing here.</h1>
    <p class="mb-8">The page you are looking for does not exist or has been moved.</p>
    <a href="/">&larr; Back to the home page</a>
  </div>
</main>
